opam-version: "2.0"
synopsis: "Local semantic indexing in SQLite for OCaml"
description: "OCaml library for persistent semantic indexes in SQLite, with multilingual E5 embeddings, FTS5 keyword search, exact and approximate vector search, and hybrid ranking."
maintainer: "Mathias Bourgoin"
authors: ["Mathias Bourgoin"]
license: "MIT"
homepage: "https://github.com/mathiasbourgoin/semantic-sqlite"
bug-reports: "https://github.com/mathiasbourgoin/semantic-sqlite/issues"
dev-repo: "git+https://github.com/mathiasbourgoin/semantic-sqlite.git"
x-maintenance-intent: ["(latest)"]
available: os = "linux"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.16"}
  "yojson"
  "uutf"
  "uunf"
  "caqti" {>= "2.3"}
  "caqti-driver-sqlite3"
  "sqlite3"
  "ocamlfind"
  "conf-pkg-config" {build}
  "eio" {>= "0.12"}
  "eio_main" {with-test}
  "uri" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test}]
]
