(library
 (name semantic_sqlite_sqlite3)
 (public_name semantic-sqlite.sqlite3)
 (libraries semantic-sqlite sqlite3 findlib))

(rule
 (target vec1.so)
 (deps vendor/vec1.c)
 (action
  (progn
   (run pkg-config --atleast-version=3.38.0 sqlite3)
   (run %{cc} -O3 -DNDEBUG -Werror=implicit-function-declaration -fPIC -shared %{dep:vendor/vec1.c} -o %{target} -lm -pthread))))

(install
 (section lib)
 (files vec1.so))
